# Football Intelligence Platform — environment template
# Copy to .env and fill in locally. Never commit .env.
# Values below are non-functional placeholders.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (SQLite only in Phase 3)
# Relative paths are resolved from the process working directory.
DATABASE_URL=sqlite+pysqlite:///./data/football.db
SQLITE_WAL_ENABLED=true
SQLITE_BUSY_TIMEOUT_MS=5000

# Raw provider payload archive
RAW_STORAGE_DIR=./data/raw

# API
API_PAGE_SIZE_DEFAULT=25
API_PAGE_SIZE_MAX=100
API_DOCS_ENABLED=true
DATA_STALE_AFTER_MINUTES=360

# Reference provider: football-data.org
# Leave empty to run without live provider access.
FOOTBALL_DATA_ORG_TOKEN=
FOOTBALL_DATA_ORG_BASE_URL=https://api.football-data.org/v4
PROVIDER_REQUESTS_PER_MINUTE=10

# HTTP behaviour
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=1.0

# Synchronisation (worker only)
SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=60
SYNC_LOOKBACK_DAYS=3
SYNC_LOOKAHEAD_DAYS=14
SYNC_COMPETITION_IDS=
SYNC_STATISTICS_LIMIT_PER_RUN=25
# A run still marked `running` after this long is treated as abandoned by a crashed
# worker and marked failed at the next startup.
SYNC_STALE_RUN_AFTER_MINUTES=360

# Identity: a fixture is matched to an existing internal match only if the kickoff is
# within this many minutes. Ambiguity inside the window is quarantined, never merged.
IDENTITY_KICKOFF_WINDOW_MINUTES=180
